# ──────────────────────────────────────────────────────────────────────────────
# MediQueue — monorepo .gitignore
# Covers: backend/ (Node/TypeScript)  frontend/ (Next.js)  root (Docker)
# ──────────────────────────────────────────────────────────────────────────────


# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# ── Environment & Secrets  ────────────────────────────────────────────────────
# Commit .env.example files — never the real ones
.env
.env.local
.env.development
.env.production
.env.test
.env.staging


# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
.next/


# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts


# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/


# ── Docker ───────────────────────────────────────────────────────────────────
.docker/


# ── Next.js / PWA generated files ────────────────────────────────────────────
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map


# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini


# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.kilo


# ── Certificates & Keys ───────────────────────────────────────────────────────
*.pem
*.key
*.cert


# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ── Claude working files (never commit) ──────────────────────────────────────
_delete_me/
Claude outputs/
Claude Outputs/
.env.prod

# ─────────────────────────────────────────────────────────────────────────────
#  MediQueue — Backend Environment Variables
#
#  Copy this file to .env and fill in real values.
#  For docker compose, env vars are set directly in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:your_password@localhost:5432/mediqueue

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_secret

# ── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@mediqueue.app

# ── Web Push (PWA push notifications) ────────────────────────────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mediqueue.app

# ── Seeds (Docker only) ───────────────────────────────────────────────────────
# Set to "true" to seed demo tenants and patients on startup.
SEED_DEMO=false

# ── Super Admin credentials (used by seed:super-admin script) ─────────────────
SUPER_ADMIN_EMAIL=admin@mediqueue.app
SUPER_ADMIN_PASSWORD=change_me_in_production
SUPER_ADMIN_NAME=Platform Owner
